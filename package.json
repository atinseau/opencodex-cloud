{
  "name": "opencodex-cloud",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "bun run --parallel --no-exit-on-error knip:all knip:production",
    "knip:all": "bun --bun knip-bun",
    "knip:production": "bun --bun knip-bun --production --strict",
    "test": "bun test --parallel",
    "check": "bun run --parallel --no-exit-on-error format:check typecheck lint knip:all knip:production test",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "hooks:install": "lefthook install"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.5",
    "@effect/tsgo": "0.56.0",
    "@types/bun": "1.4.4",
    "knip": "6.43.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.6"
  },
  "packageManager": "bun@1.4.4"
}
