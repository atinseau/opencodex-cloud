# Generate each value independently with: openssl rand -base64 48
OPENCODEX_API_AUTH_TOKEN=replace-with-a-strong-random-data-plane-token
OPENCODEX_ADMIN_AUTH_TOKEN=replace-with-a-different-strong-random-admin-token

# Exact external HTTPS origin, without a trailing slash.
OPENCODEX_PUBLIC_ORIGIN=https://ai.example.com

TZ=Europe/Paris

